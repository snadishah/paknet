{
  "name": "paknet",
  "version": "0.2.0",
  "private": true,
  "description": "Pakistan internet traffic & routing simulator (three.js) — Computer Networks course project, proof of concept",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch --serve",
    "serve": "node scripts/serve.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:v1": "node scripts/build.mjs --v1",
    "data": "node scripts/extract-geo.js && node scripts/merge-provinces.js && node scripts/fit-provinces.mjs",
    "experiment": "node scripts/experiment.mjs",
    "report": "node scripts/experiment.mjs && python scripts/report_charts.py && node scripts/report.mjs",
    "report:doc": "node scripts/report.mjs",
    "preview": "node scripts/serve.mjs 4173",
    "verify": "node scripts/verify.mjs",
    "orbits": "node scripts/fetch-orbits.mjs",
    "buildings": "node scripts/fetch-buildings.mjs"
  },
  "dependencies": {
    "satellite.js": "^7.2.0",
    "three": "^0.160.1"
  },
  "devDependencies": {
    "@highcharts/map-collection": "^2.3.3",
    "all-the-cities": "^3.1.0",
    "docx": "^9.16.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.65.1",
    "polygon-clipping": "^0.15.7",
    "proj4": "^2.23.0",
    "topojson-client": "^3.1.0",
    "vitest": "^5.1.1",
    "world-atlas": "^2.0.2"
  }
}
